{
  "name": "markdown-knowledge-graph",
  "version": "0.1.0",
  "description": "Render a knowledge graph from a folder of Obsidian-style markdown notes: wikilink parser, d3-force layout, canvas renderer.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "graph": "tsx scripts/build-graph.mjs",
    "generate:large": "node scripts/generate-large.mjs",
    "bench:layout": "tsx scripts/bench-layout.mjs"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^3.2.7"
  }
}
